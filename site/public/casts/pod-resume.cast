{"version": 2, "width": 96, "height": 30, "timestamp": 1790049574, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}, "title": "agentsessions: a session outlives its pod"}
[0.695815, "o", "\r\n\u001b[1;36m# One pod, one PersistentVolume, no substrate and no memory snapshot.\u001b[0m\r\n"]
[1.703801, "o", "\u001b[1;32m$\u001b[0m kubectl -n agentsessions get pod -l app=agentsessionsd -o name\r\n"]
[2.373901, "o", "pod/agentsessionsd-58554f4f95-97vhj\r\n"]
[3.386539, "o", "\r\n\u001b[1;36m# Run a turn against the in-cluster server.\u001b[0m\r\n"]
[4.438926, "o", "\u001b[1;32m$\u001b[0m agentctl exec --server 127.0.0.1:18080 --input \"hello from kubernetes\"\r\nsession sess-728e8ed67ff48d0d6447de29\r\nseq=1   EVENT_INPUT  user: hello from kubernetes\r\nseq=2   EVENT_MODEL_CALL\r\n"]
[4.439049, "o", "seq=3   EVENT_OUTPUT  assistant: echo:hello from kubernetes\r\nseq=4   EVENT_END\r\n"]
[5.466715, "o", "\r\n\u001b[1;36m# Now kill the pod that served it.\u001b[0m\r\n"]
[6.484832, "o", "\u001b[1;32m$\u001b[0m kubectl -n agentsessions delete pod -l app=agentsessionsd\r\n"]
[7.158981, "o", "pod \"agentsessionsd-58554f4f95-97vhj\" deleted from agentsessions namespace\r\n"]
[8.992244, "o", "\u001b[1;32m$\u001b[0m kubectl -n agentsessions rollout status deploy/agentsessionsd --timeout=120s\r\n"]
[9.6583, "o", "Waiting for deployment \"agentsessionsd\" rollout to finish: 0 of 1 updated replicas are available...\r\n"]
[12.99102, "o", "deployment \"agentsessionsd\" successfully rolled out\r\n"]
[15.565708, "o", "\r\n\u001b[1;36m# A different pod. Replay the session it never ran: byte-identical, model called zero times.\u001b[0m\r\n"]
[16.573703, "o", "\u001b[1;32m$\u001b[0m agentctl replay --server 127.0.0.1:18080 --session sess-728e8ed67ff48d0d6447de29 2>/dev/null\r\n"]
[17.216878, "o", "seq=1   EVENT_INPUT  user: hello from kubernetes\r\nseq=2   EVENT_MODEL_CALL\r\nseq=3   EVENT_OUTPUT  assistant: echo:hello from kubernetes\r\nseq=4   EVENT_END\r\n"]
[18.22877, "o", "\r\n\u001b[1;36m# And it is still writable. The session continues where it stopped.\u001b[0m\r\n"]
[19.239807, "o", "\u001b[1;32m$\u001b[0m agentctl exec --server 127.0.0.1:18080 --session sess-728e8ed67ff48d0d6447de29 --input 'still here after pod death' 2>/dev/null\r\n"]
[19.876555, "o", "seq=5   EVENT_INPUT  user: still here after pod death\r\n"]
[19.878, "o", "seq=6   EVENT_MODEL_CALL\r\n"]
[19.878825, "o", "seq=7   EVENT_OUTPUT  assistant: echo:still here after pod death\r\n"]
[19.880088, "o", "seq=8   EVENT_END\r\n"]
[20.895041, "o", "\r\n\u001b[1;36m# The pod was cattle. The session was not.\u001b[0m\r\n"]
