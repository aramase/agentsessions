{"version": 2, "width": 100, "height": 18, "timestamp": 1790060697, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}, "title": "agentsessions on Kubernetes: a session outlives its pod"}
[0.75472, "o", "\r\n\u001b[1;36m# One pod, one PersistentVolume, no substrate and no memory snapshot.\u001b[0m\r\n"]
[1.762798, "o", "\u001b[1;32m$\u001b[0m kubectl -n agentsessions get pod -l app=agentsessionsd -o name\r\n"]
[2.431615, "o", "pod/agentsessionsd-58554f4f95-cwdtz\r\n"]
[3.445745, "o", "\r\n\u001b[1;36m# Run a turn against the in-cluster server.\u001b[0m\r\n"]
[4.576325, "o", "\u001b[1;32m$\u001b[0m agentctl exec --server 127.0.0.1:18080 --input \"hello from kubernetes\"\r\nsession sess-55944b077e7cbdee9f0b4456\r\nseq=1   EVENT_INPUT  user: hello from kubernetes\r\nseq=2   EVENT_MODEL_CALL\r\nseq=3   EVENT_OUTPUT  assistant: echo:hello from kubernetes\r\nseq=4   EVENT_END\r\n"]
[5.598049, "o", "\r\n\u001b[1;36m# Now kill the pod that served it.\u001b[0m\r\n"]
[6.60807, "o", "\u001b[1;32m$\u001b[0m kubectl -n agentsessions delete pod -l app=agentsessionsd\r\n"]
[7.275055, "o", "pod \"agentsessionsd-58554f4f95-cwdtz\" deleted from agentsessions namespace\r\n"]
[9.062987, "o", "\u001b[1;32m$\u001b[0m kubectl -n agentsessions rollout status deploy/agentsessionsd --timeout=120s\r\n"]
[9.74646, "o", "Waiting for deployment \"agentsessionsd\" rollout to finish: 0 of 1 updated replicas are available...\r\n"]
[13.058695, "o", "deployment \"agentsessionsd\" successfully rolled out\r\n"]
[15.6246, "o", "\r\n\u001b[1;36m# A different pod. Replay the session it never ran: byte-identical, model called zero times.\u001b[0m\r\n"]
[16.644587, "o", "\u001b[1;32m$\u001b[0m agentctl replay --server 127.0.0.1:18080 --session sess-55944b077e7cbdee9f0b4456 2>/dev/null\r\n"]
[17.288881, "o", "seq=1   EVENT_INPUT  user: hello from kubernetes\r\nseq=2   EVENT_MODEL_CALL\r\nseq=3   EVENT_OUTPUT  assistant: echo:hello from kubernetes\r\nseq=4   EVENT_END\r\n"]
[18.301208, "o", "\r\n\u001b[1;36m# And it is still writable. The session continues where it stopped.\u001b[0m\r\n"]
[19.314277, "o", "\u001b[1;32m$\u001b[0m agentctl exec --server 127.0.0.1:18080 --session sess-55944b077e7cbdee9f0b4456 --input 'still here after pod death' 2>/dev/null\r\n"]
[20.005033, "o", "seq=5   EVENT_INPUT  user: still here after pod death\r\n"]
[20.007185, "o", "seq=6   EVENT_MODEL_CALL\r\n"]
[20.008072, "o", "seq=7   EVENT_OUTPUT  assistant: echo:still here after pod death\r\n"]
[20.009525, "o", "seq=8   EVENT_END\r\n"]
[21.021998, "o", "\r\n\u001b[1;36m# The pod was cattle. The session was not.\u001b[0m\r\n"]
