{"version": 2, "width": 104, "height": 22, "timestamp": 1790061953, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}, "title": "agentsessions on Kubernetes"}
[0.633741, "o", "\r\n\u001b[1;36m# agentsessionsd on a plain Kubernetes Deployment. One pod, one PersistentVolume.\u001b[0m\r\n"]
[2.046078, "o", "\u001b[1;32m$\u001b[0m kubectl -n agentsessions get deploy,pvc,pod -l app=agentsessionsd 2>/dev/null | grep -v '^$'\r\n"]
[2.827881, "o", "NAME                                  READY   STATUS    RESTARTS   AGE\r\npod/agentsessionsd-58554f4f95-dfhf6   1/1     Running   0          24s\r\n"]
[4.137592, "o", "\r\n\u001b[1;36m# 1. Run a turn.\u001b[0m\r\n"]
[5.643145, "o", "\u001b[1;32m$\u001b[0m agentctl exec --input \"plan a trip to Tokyo\"\r\n"]
[6.352245, "o", "session sess-323ddcb49f18950b95803b71\r\nseq=1   EVENT_INPUT  user: plan a trip to Tokyo\r\nseq=2   EVENT_MODEL_CALL\r\nseq=3   EVENT_OUTPUT  assistant: echo:plan a trip to Tokyo\r\nseq=4   EVENT_END\r\n"]
[6.362646, "o", "\u001b[0;90m  four typed records: the input, the host-mediated model call, the output, the end\u001b[0m\r\n"]
[8.60202, "o", "\r\n\u001b[1;36m# 2. Keep talking. The sequence keeps climbing in one log.\u001b[0m\r\n"]
[10.013885, "o", "\u001b[1;32m$\u001b[0m agentctl exec --server 127.0.0.1:18080 --session sess-323ddcb49f18950b95803b71 --input 'make it a week' 2>/dev/null\r\n"]
[10.753303, "o", "seq=5   EVENT_INPUT  user: make it a week\r\n"]
[10.754894, "o", "seq=6   EVENT_MODEL_CALL\r\n"]
[10.755886, "o", "seq=7   EVENT_OUTPUT  assistant: echo:make it a week\r\n"]
[10.757716, "o", "seq=8   EVENT_END\r\n"]
[12.068188, "o", "\r\n\u001b[1;36m# 3. Replay the whole session. The harness never runs; the provider is never called.\u001b[0m\r\n"]
[13.486551, "o", "\u001b[1;32m$\u001b[0m agentctl replay --server 127.0.0.1:18080 --session sess-323ddcb49f18950b95803b71 2>/dev/null\r\n"]
[14.226312, "o", "seq=1   EVENT_INPUT  user: plan a trip to Tokyo\r\nseq=2   EVENT_MODEL_CALL\r\n"]
[14.226426, "o", "seq=3   EVENT_OUTPUT  assistant: echo:plan a trip to Tokyo\r\nseq=4   EVENT_END\r\nseq=5   EVENT_INPUT  user: make it a week\r\nseq=6   EVENT_MODEL_CALL\r\nseq=7   EVENT_OUTPUT  assistant: echo:make it a week\r\nseq=8   EVENT_END\r\n"]
[15.541997, "o", "\u001b[0;90m  identical bytes, served from the journal\u001b[0m\r\n"]
[16.552953, "o", "\r\n\u001b[1;36m# 4. Fork it. Two children branch from seq 4, at no model cost.\u001b[0m\r\n"]
[18.017594, "o", "\u001b[1;32m$\u001b[0m agentctl fork --session sess-323ddcb49f189 --at 4 --count 2 --names \"budget,luxury\"\r\n"]
[18.729979, "o", "child sess-13ecb0df5bc3d46ecff38ca5 parent=sess-323ddcb49f18950b95803b71 fork_seq=4 name=budget\r\nchild sess-d83f5ff601e8c61fb28480f3 parent=sess-323ddcb49f18950b95803b71 fork_seq=4 name=luxury\r\n"]
[20.0591, "o", "\r\n\u001b[1;36m# 5. A child inherits the prefix, then diverges on its own.\u001b[0m\r\n"]
[21.472129, "o", "\u001b[1;32m$\u001b[0m agentctl replay --server 127.0.0.1:18080 --session sess-13ecb0df5bc3d46ecff38ca5 2>/dev/null | tail -3\r\n"]
[22.224174, "o", "seq=3   EVENT_OUTPUT  assistant: echo:plan a trip to Tokyo\r\nseq=4   EVENT_END\r\nseq=5   EVENT_LIFECYCLE\r\n"]
[23.532725, "o", "\u001b[1;32m$\u001b[0m agentctl exec --server 127.0.0.1:18080 --session sess-13ecb0df5bc3d46ecff38ca5 --input 'child-only turn' 2>/dev/null | tail -4\r\n"]
[24.279987, "o", "seq=6   EVENT_INPUT  user: child-only turn\r\nseq=7   EVENT_MODEL_CALL\r\nseq=8   EVENT_OUTPUT  assistant: echo:child-only turn\r\nseq=9   EVENT_END\r\n"]
[25.589869, "o", "\u001b[0;90m  the parent is untouched; each branch owns its own future\u001b[0m\r\n"]
[26.600035, "o", "\r\n\u001b[1;36m# 6. Suspend releases compute. Resume brings it back.\u001b[0m\r\n"]
[28.00915, "o", "\u001b[1;32m$\u001b[0m agentctl suspend --server 127.0.0.1:18080 --session sess-323ddcb49f18950b95803b71 2>/dev/null\r\n"]
[28.744904, "o", "session sess-323ddcb49f18950b95803b71 suspend compute=COMPUTE_COLD last_seq=9\r\n"]
[30.052787, "o", "\u001b[1;32m$\u001b[0m agentctl resume --server 127.0.0.1:18080 --session sess-323ddcb49f18950b95803b71 2>/dev/null\r\n"]
[30.787732, "o", "session sess-323ddcb49f18950b95803b71 resume compute=COMPUTE_LIVE last_seq=10\r\n"]
[32.126345, "o", "\r\n\u001b[1;36m# 7. Sessions are listable, with or without compute.\u001b[0m\r\n"]
[33.542825, "o", "\u001b[1;32m$\u001b[0m agentctl list --server 127.0.0.1:18080 2>/dev/null | head -5\r\n"]
[34.290322, "o", "sess-d83f5ff601e8c61fb28480f3\tlast_seq=5\tcompute=COLD\tharness=echo\tname=luxury\r\nsess-13ecb0df5bc3d46ecff38ca5\tlast_seq=9\tcompute=LIVE\tharness=echo\tname=budget\r\nsess-323ddcb49f18950b95803b71\tlast_seq=10\tcompute=LIVE\tharness=echo\tname=\r\n"]
[35.600055, "o", "\r\n\u001b[1;36m# 8. Now delete the pod serving all of this.\u001b[0m\r\n"]
[37.007082, "o", "\u001b[1;32m$\u001b[0m kubectl -n agentsessions delete pod -l app=agentsessionsd\r\n"]
[37.782259, "o", "pod \"agentsessionsd-58554f4f95-dfhf6\" deleted from agentsessions namespace\r\n"]
[39.424799, "o", "\u001b[1;32m$\u001b[0m kubectl -n agentsessions rollout status deploy/agentsessionsd --timeout=120s\r\n"]
[40.255881, "o", "Waiting for deployment \"agentsessionsd\" rollout to finish: 0 of 1 updated replicas are available...\r\n"]
[44.121918, "o", "deployment \"agentsessionsd\" successfully rolled out\r\n"]
[47.103686, "o", "\r\n\u001b[1;36m# 9. A different pod. Replay a session it never ran.\u001b[0m\r\n"]
[48.533563, "o", "\u001b[1;32m$\u001b[0m agentctl replay --server 127.0.0.1:18080 --session sess-323ddcb49f18950b95803b71 2>/dev/null | tail -4\r\n"]
[49.314846, "o", "seq=7   EVENT_OUTPUT  assistant: echo:make it a week\r\nseq=8   EVENT_END\r\nseq=9   EVENT_LIFECYCLE\r\nseq=10  EVENT_LIFECYCLE\r\n"]
[50.623836, "o", "\r\n\u001b[1;36m# 10. And continue it, in the same log, from where it stopped.\u001b[0m\r\n"]
[52.029252, "o", "\u001b[1;32m$\u001b[0m agentctl exec --server 127.0.0.1:18080 --session sess-323ddcb49f18950b95803b71 --input 'still here after pod death' 2>/dev/null | tail -4\r\n"]
[52.782675, "o", "seq=11  EVENT_INPUT  user: still here after pod death\r\nseq=12  EVENT_MODEL_CALL\r\nseq=13  EVENT_OUTPUT  assistant: echo:still here after pod death\r\nseq=14  EVENT_END\r\n"]
[54.090939, "o", "\r\n\u001b[1;36m# The pod was cattle. The session was not.\u001b[0m\r\n"]
