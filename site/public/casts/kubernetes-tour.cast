{"version": 2, "width": 100, "height": 22, "timestamp": 1790095108, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}, "title": "agentsessions on Kubernetes"}
[0.675286, "o", "\r\n\u001b[1;36m# agentsessionsd on a plain Kubernetes Deployment. One pod, one PersistentVolume.\u001b[0m\r\n"]
[2.084691, "o", "\u001b[1;32m$\u001b[0m kubectl -n $NS get deploy,pvc,pod -l app=agentsessionsd -o name\r\n"]
[2.850821, "o", "deployment.apps/agentsessionsd\r\npersistentvolumeclaim/agentsessionsd-journal\r\npod/agentsessionsd-58554f4f95-bmsgp\r\n"]
[4.16311, "o", "\u001b[0;90m  SERVER=127.0.0.1:18080, forwarded from svc/agentsessionsd:8080\u001b[0m\r\n"]
[5.181456, "o", "\r\n\u001b[1;36m# 1. Run a turn.\u001b[0m\r\n"]
[6.67046, "o", "\u001b[1;32m$\u001b[0m agentctl exec --input \"plan a trip to Tokyo\"\r\n"]
[7.386194, "o", "session sess-8f9b01ec15d752101381845c\r\nseq=1   EVENT_INPUT  user: plan a trip to Tokyo\r\nseq=2   EVENT_MODEL_CALL\r\nseq=3   EVENT_OUTPUT  assistant: echo:plan a trip to Tokyo\r\nseq=4   EVENT_END\r\n"]
[7.413034, "o", "\u001b[0;90m  four typed records: the input, the host-mediated model call, the output, the end\u001b[0m\r\n"]
[9.64595, "o", "\r\n\u001b[1;36m# 2. Keep talking. The sequence keeps climbing in one log.\u001b[0m\r\n"]
[11.058683, "o", "\u001b[1;32m$\u001b[0m agentctl exec --server $SERVER --session $SID --input \"make it a week\"\r\n"]
[11.806265, "o", "seq=5   EVENT_INPUT  user: make it a week\r\n"]
[11.807868, "o", "seq=6   EVENT_MODEL_CALL\r\n"]
[11.808877, "o", "seq=7   EVENT_OUTPUT  assistant: echo:make it a week\r\n"]
[11.810241, "o", "seq=8   EVENT_END\r\n"]
[13.123684, "o", "\r\n\u001b[1;36m# 3. Replay the whole session. The harness never runs; the provider is never called.\u001b[0m\r\n"]
[14.534611, "o", "\u001b[1;32m$\u001b[0m agentctl replay --server $SERVER --session $SID\r\n"]
[15.268094, "o", "seq=1   EVENT_INPUT  user: plan a trip to Tokyo\r\nseq=2   EVENT_MODEL_CALL\r\nseq=3   EVENT_OUTPUT  assistant: echo:plan a trip to Tokyo\r\nseq=4   EVENT_END\r\nseq=5   EVENT_INPUT  user: make it a week\r\nseq=6   EVENT_MODEL_CALL\r\nseq=7   EVENT_OUTPUT  assistant: echo:make it a week\r\n"]
[15.268214, "o", "seq=8   EVENT_END\r\n"]
[16.579724, "o", "\u001b[0;90m  identical bytes, served from the journal\u001b[0m\r\n"]
[17.593357, "o", "\r\n\u001b[1;36m# 4. Fork it. Two children branch from seq 4, at no model cost.\u001b[0m\r\n"]
[19.057181, "o", "\u001b[1;32m$\u001b[0m agentctl fork --session sess-8f9b01ec15d75 --at 4 --count 2 --names \"budget,luxury\"\r\n"]
[19.80481, "o", "child sess-e0ba33c0cd39588ff2d8a479 parent=sess-8f9b01ec15d752101381845c fork_seq=4 name=budget\r\nchild sess-553d99000c2e97266574bc89 parent=sess-8f9b01ec15d752101381845c fork_seq=4 name=luxury\r\n"]
[21.131476, "o", "\r\n\u001b[1;36m# 5. A child inherits the prefix, then diverges on its own.\u001b[0m\r\n"]
[22.550045, "o", "\u001b[1;32m$\u001b[0m agentctl replay --server $SERVER --session $CHILD | tail -3\r\n"]
[23.315381, "o", "seq=3   EVENT_OUTPUT  assistant: echo:plan a trip to Tokyo\r\nseq=4   EVENT_END\r\nseq=5   EVENT_LIFECYCLE\r\n"]
[24.623418, "o", "\u001b[1;32m$\u001b[0m agentctl exec --server $SERVER --session $CHILD --input \"child-only turn\" | tail -4\r\n"]
[25.381164, "o", "seq=6   EVENT_INPUT  user: child-only turn\r\nseq=7   EVENT_MODEL_CALL\r\nseq=8   EVENT_OUTPUT  assistant: echo:child-only turn\r\nseq=9   EVENT_END\r\n"]
[26.69031, "o", "\u001b[0;90m  the parent is untouched; each branch owns its own future\u001b[0m\r\n"]
[27.700063, "o", "\r\n\u001b[1;36m# 6. Suspend releases compute. Resume brings it back.\u001b[0m\r\n"]
[29.11404, "o", "\u001b[1;32m$\u001b[0m agentctl suspend --server $SERVER --session $SID\r\n"]
[29.867609, "o", "session sess-8f9b01ec15d752101381845c suspend compute=COMPUTE_COLD last_seq=9\r\n"]
[31.177435, "o", "\u001b[1;32m$\u001b[0m agentctl resume --server $SERVER --session $SID\r\n"]
[31.916959, "o", "session sess-8f9b01ec15d752101381845c resume compute=COMPUTE_LIVE last_seq=10\r\n"]
[33.22583, "o", "\r\n\u001b[1;36m# 7. Sessions are listable, with or without compute.\u001b[0m\r\n"]
[34.640518, "o", "\u001b[1;32m$\u001b[0m agentctl list --server $SERVER | head -5\r\n"]
[35.384396, "o", "sess-553d99000c2e97266574bc89\tlast_seq=5\tcompute=COLD\tharness=echo\tname=luxury\r\nsess-e0ba33c0cd39588ff2d8a479\tlast_seq=9\tcompute=LIVE\tharness=echo\tname=budget\r\nsess-8f9b01ec15d752101381845c\tlast_seq=10\tcompute=LIVE\tharness=echo\tname=\r\n"]
[36.69339, "o", "\r\n\u001b[1;36m# 8. Now delete the pod serving all of this.\u001b[0m\r\n"]
[38.111497, "o", "\u001b[1;32m$\u001b[0m kubectl -n $NS delete pod -l app=agentsessionsd\r\n"]
[38.887741, "o", "pod \"agentsessionsd-58554f4f95-bmsgp\" deleted from agentsessions namespace\r\n"]
[41.291407, "o", "\u001b[1;32m$\u001b[0m kubectl -n $NS rollout status deploy/agentsessionsd --timeout=120s\r\n"]
[42.062966, "o", "Waiting for deployment \"agentsessionsd\" rollout to finish: 0 of 1 updated replicas are available...\r\n"]
[44.986966, "o", "deployment \"agentsessionsd\" successfully rolled out\r\n"]
[47.879876, "o", "\r\n\u001b[1;36m# 9. A different pod. Replay a session it never ran.\u001b[0m\r\n"]
[49.290332, "o", "\u001b[1;32m$\u001b[0m agentctl replay --server $SERVER --session $SID | tail -4\r\n"]
[50.024165, "o", "seq=7   EVENT_OUTPUT  assistant: echo:make it a week\r\nseq=8   EVENT_END\r\nseq=9   EVENT_LIFECYCLE\r\nseq=10  EVENT_LIFECYCLE\r\n"]
[51.336619, "o", "\r\n\u001b[1;36m# 10. And continue it, in the same log, from where it stopped.\u001b[0m\r\n"]
[52.747465, "o", "\u001b[1;32m$\u001b[0m agentctl exec --server $SERVER --session $SID --input \"still here after pod death\" | tail -4\r\n"]
[53.490962, "o", "seq=11  EVENT_INPUT  user: still here after pod death\r\nseq=12  EVENT_MODEL_CALL\r\nseq=13  EVENT_OUTPUT  assistant: echo:still here after pod death\r\nseq=14  EVENT_END\r\n"]
[54.801319, "o", "\r\n\u001b[1;36m# The pod was cattle. The session was not.\u001b[0m\r\n"]
